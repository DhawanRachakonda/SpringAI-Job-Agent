ANTHROPIC_API_KEY=sk-ant-your-key-here
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/
# Optional: smaller/cheaper model
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: web server port (default 8080)
# PORT=8080
# Optional: MongoDB database and collection (defaults: jd_intake_db and jobs_springai)
# MONGO_DB=jd_intake_db
# MONGO_COLLECTION=jobs_springai
